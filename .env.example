# Copy to `.env` (gitignored) to override any default path or setting.
# Loaded via pydantic-settings / python-dotenv. All keys are optional.

# Override where generated/working data lives (defaults to <repo>/data).
# GLYPHLOOP_DATA_DIR=/abs/path/to/data

# Override where model checkpoints are read/written (defaults to <repo>/models).
# GLYPHLOOP_MODELS_DIR=/abs/path/to/models
